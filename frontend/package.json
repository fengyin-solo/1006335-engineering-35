{
  "name": "urban-utility-tunnel-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "repoKind": "frontend-only",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:deploy": "npm run verify && npm run build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "verify": "node scripts/run-verify.mjs"
  },
  "dependencies": {
    "pinia": "2.3.1",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@vitejs/plugin-vue": "5.2.4",
    "esbuild": "0.21.5",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vue-tsc": "2.2.12"
  },
  "supportedArchitectures": {
    "os": [
      "linux",
      "darwin"
    ],
    "cpu": [
      "arm64",
      "x64"
    ],
    "libc": [
      "glibc"
    ]
  }
}
