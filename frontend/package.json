{
  "name": "urban-utility-tunnel-frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "repoKind": "frontend-only",
  "scripts": {
    "dev": "vite",
    "build": "npm run emergency:generate && npm run emergency:verify && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "emergency:generate": "node --import ./scripts/register.mjs ./scripts/emergency-pipeline.mts generate",
    "emergency:verify": "node --import ./scripts/register.mjs ./scripts/emergency-pipeline.mts verify",
    "test:emergency": "node --import ./scripts/register.mjs ./scripts/test-emergency.mts",
    "smoke:store": "node --import ./scripts/register.mjs ./scripts/smoke-store.mts",
    "test": "npm run test:emergency && npm run smoke:store"
  },
  "dependencies": {
    "pinia": "2.3.1",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@vitejs/plugin-vue": "5.2.4",
    "esbuild": "0.21.5",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vue-tsc": "2.2.12"
  }
}
